{
  "name": "RepoScope",
  "url": "https://reposcope-api.reposcope.workers.dev",
  "hook_attributes": {
    "url": "https://reposcope-api.reposcope.workers.dev/webhooks/github",
    "active": true
  },
  "redirect_url": "https://reposcope-api.reposcope.workers.dev/auth/github/callback",
  "callback_urls": [
    "https://reposcope-api.reposcope.workers.dev/auth/github/callback"
  ],
  "setup_url": "https://reposcope-api.reposcope.workers.dev/auth/github/setup",
  "setup_on_update": true,
  "public": false,
  "default_permissions": {
    "actions": "read",
    "checks": "read",
    "contents": "read",
    "issues": "read",
    "members": "read",
    "metadata": "read",
    "pull_requests": "read",
    "statuses": "read"
  },
  "default_events": [
    "check_run",
    "check_suite",
    "issue_comment",
    "issues",
    "pull_request",
    "pull_request_review",
    "push",
    "release",
    "workflow_run"
  ]
}
